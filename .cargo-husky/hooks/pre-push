#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# git-release already ran every check on this exact tree.
if [ -n "${SARAH_RELEASE_VALIDATED_TREE:-}" ] && \
    [ "$(git rev-parse 'HEAD^{tree}')" = "$SARAH_RELEASE_VALIDATED_TREE" ]; then
    exit 0
fi
sh scripts/check.sh test
sh scripts/check.sh sarah
